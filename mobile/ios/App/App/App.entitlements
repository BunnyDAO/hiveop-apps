<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push needs the Push Notifications capability on the app id in the owner's Apple account.
	     "development" is rewritten to "production" by distribution signing. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
